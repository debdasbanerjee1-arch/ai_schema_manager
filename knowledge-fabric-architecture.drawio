<mxfile host="app.diagrams.net"><diagram id="kf-arch" name="Target architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1606" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Knowledge Fabric: target architecture" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Harvest once into inventories, then model many times. Only harvesters call AWS; the resolver rebuilds the graph from one inventory snapshot on every run. Dashed boxes are planned, solid boxes are built." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1500" height="30" as="geometry"/></mxCell><mxCell id="n4" value="AWS production account (read-only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="310" height="754" as="geometry"/></mxCell><mxCell id="n5" value="Harvesters: only they call AWS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="310" height="754" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;AWS DMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;endpoints, tasks, table statistics&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D79B00;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="