="n93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="n91" target="n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n94" value='&lt;b&gt;Confluence&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;definitions through the Confluence MCP (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n74"><mxGeometry x="16" y="364" width="278" height="46" as="geometry"/></mxCell><mxCell id="n95" value='&lt;b&gt;harvest confluence&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n75"><mxGeometry x="16" y="364" width="278" height="46" as="geometry"/></mxCell><mxCell id="n96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="n94" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n97" value='&lt;b&gt;PAS schema extract&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;optional, where a vendor provides one (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n74"><mxGeometry x="16" y="418" width="278" height="46" as="geometry"/></mxCell><mxCell id="n98" value='&lt;b&gt;import extract&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n75"><mxGeometry x="16" y="418" width="278" height="46" as="geometry"/></mxCell><mxCell id="n99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="n97" target="n98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n100" value='&lt;b&gt;Bitbucket code&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;local clone of Glue and Lambda repos&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="n74"><mxGeometry x="16" y="472" width="278" height="46" as="geometry"/></mxCell><mxCell id="n101" value='&lt;b&gt;parse code&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;config access, SQL parsing, inputs and outputs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="n75"><mxGeometry x="16" y="472" width="278" height="46" as="geometry"/></mxCell><mxCell id="n102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="n100" target="n101"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n103" value='&lt;b&gt;SME corrections&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;confirmations and fixes captured in the UI (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n74"><mxGeometry x="16" y="526" width="278" height="46" as="geometry"/></mxCell><mxCell id="n104" value='&lt;b&gt;import corrections&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;kept outside the graph, so a rebuild never loses them (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n75"><mxGeometry x="16" y="526" width="278" height="46" as="geometry"/></mxCell><mxCell id="n105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;dashed=1;" edge="1" parent="1" source="n103" target="n104"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Storage format&lt;/b&gt;&lt;br&gt;runs/&amp;lt;harvester&amp;gt;/&amp;lt;run_id&amp;gt;/&amp;lt;kind&amp;gt;.jsonl&lt;br&gt;one record per object: the full API response, redacted before writing&lt;br&gt;run.json: scope (complete or partial), counts, errors, API actions used&lt;br&gt;snapshots/&amp;lt;id&amp;gt;.json: the chosen complete run of each harvester" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="924" width="310" height="190" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;Capture wide, model narrow&lt;br&gt;A partial run never means &amp;#x27;deleted&amp;#x27;&lt;br&gt;Model changes never need AWS calls&lt;br&gt;Declared config stays in Git, never in the data folder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1134" width="310" height="130" as="geometry"/></mxCell><mxCell id="n108" value="&lt;b&gt;Every edge records&lt;/b&gt;&lt;br&gt;origin: observed, declared or derived&lt;br&gt;rule: R1 to R11&lt;br&gt;evidence: inventory record ids&lt;br&gt;snapshot id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="924" width="310" height="130" as="geometry"/></mxCell><mxCell id="n109" value="&lt;b&gt;Run order&lt;/b&gt;&lt;br&gt;R1, R2, R3, R5, R7, R4, R6, R8, build, R11&lt;br&gt;Rules run in dependency order, not numeric order&lt;br&gt;Rebuilds from scratch every run, so a rule change never needs a re-harvest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="1074" width="310" height="130" as="geometry"/></mxCell><mxCell id="n110" value="&lt;b&gt;Three kinds of fact, never mixed&lt;/b&gt;&lt;br&gt;Observed: inventories from AWS&lt;br&gt;Declared: config and documents from people&lt;br&gt;Derived: the graph, rebuilt by the resolver" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="924" width="340" height="110" as="geometry"/></mxCell><mxCell id="n111" value="&lt;b&gt;Production account rules (harvesters)&lt;/b&gt;&lt;br&gt;describe, list and get calls only; no data or secrets&lt;br&gt;one call at a time; back off on throttling&lt;br&gt;stop and report any denied call" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="1054" width="340" height="110" as="geometry"/></mxCell><mxCell id="n112" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Orange: AWS. Purple: declared by people. Blue: harvesters and importers.&lt;br&gt;Green: inventory. Grey: resolver. Yellow: outputs.&lt;br&gt;Solid border: built. Dashed border: planned." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1520" y="1184" width="340" height="110" as="geometry"/></mxCell><mxCell id="n113" value="JSONL records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="n5" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n114" value="declared records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="n75" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n115" value="one snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="n44" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n55" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.63;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n55" target="n72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="n69" target="n70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n119" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="n70" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n69" target="n73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="170"/><mxPoint x="1890" y="720"/></Array></mxGeometry></mxCell><mxCell id="n121" value="SME corrections return as declared inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n71" target="n103"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1910" y="465"/><mxPoint x="1910" y="1556"/><mxPoint x="15" y="1556"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>