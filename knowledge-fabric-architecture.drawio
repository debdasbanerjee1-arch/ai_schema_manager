cingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="n55"><mxGeometry x="16" y="390" width="278" height="44" as="geometry"/></mxCell><mxCell id="n64" value='&lt;b&gt;R9 Consumption&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;QuickSight, APIs, outbound extracts (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n55"><mxGeometry x="16" y="440" width="278" height="44" as="geometry"/></mxCell><mxCell id="n65" value='&lt;b&gt;R10 Business terms&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;scope, system aliases, conflicts (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n55"><mxGeometry x="16" y="490" width="278" height="44" as="geometry"/></mxCell><mxCell id="n66" value='&lt;b&gt;Applications (proposed)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;owns: from tags; uses: derived by walking the graph (planned)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;fontColor=#555555;" vertex="1" parent="n55"><mxGeometry x="16" y="540" width="278" height="44" as="geometry"/></mxCell><mxCell id="n67" value='&lt;b&gt;Graph builder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rows in memory, bulk load into the store&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="n55"><mxGeometry x="16" y="590" width="278" height="44" as="geometry"/></mxCell><mxCell id="n68" value='&lt;b&gt;R11 Verify&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;blocking checks must return zero before go-live&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;fontSize=11;verticalAlign=middle;" vertex="1" parent="n55"><mxGeometry x="16" y="640" width="278" height="44" as="geometry"/></mxCell><mxCell id="n69" value='&lt;b&gt;Knowledge graph&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;graph.node, graph.edge. DuckDB file (PoC), Aurora PostgreSQL (production). Built fresh each run, swapped in only after verify passes; the last three are kept, which gives history and rollback.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="110" width="340" height="120" as="geometry"/></mxCell><mxCell id="n70" value='&lt;b&gt;Access layer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one set of read-only query functions: inventory, lineage, flow, impact, applications, gaps. Served as a GET-only API; MCP server for AI agents (planned).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="260" width="340" height="100" as="geometry"/></mxCell><mxCell id="n71" value='&lt;b&gt;Question layer and UI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Home, Inventory, Applications, Lineage, Flow, Impact and recovery, Discover, Health. Reads the graph only, never AWS or the inventories.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="390" width="340" height="100" as="geometry"/></mxCell><mxCell id="n72" value='&lt;b&gt;Gaps and verification reports&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;everything that could not be linked, with rule, object, location, reason and evidence. Feeds the Health screen and the worklist.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="530" width="340" height="100" as="geometry"/></mxCell><mxCell id="n73" value='&lt;b&gt;Tool exports (later)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Alation, OpenMetadata: only what they cannot harvest themselves (ingestion and config lineage, source equivalents, term links).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1520" y="670" width="340" height="100" as="geometry"/></mxCell><mxCell id="n74" value="Declared inputs (maintained by people)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="924" width="310" height="592" as="geometry"/></mxCell><mxCell id="n75" value="Importers and parsers (no AWS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="410" y="924" width="310" height="592" as="geometry"/></mxCell><mxCell id="n76" value='&lt;b&gt;source_systems.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;systems, databases, aliases (COMPASS = TargetPlan)&lt;/font&gt;' style="roun